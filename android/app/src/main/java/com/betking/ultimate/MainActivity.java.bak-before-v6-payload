    /*
     * ==========================================
     * HTTP GET AUTHENTIFIÉ
     * ==========================================
     */

    private JSONObject getAuthenticated(
            String urlString
    ) throws Exception {

        URL url =
                new URL(urlString);

        HttpURLConnection connection =
                (HttpURLConnection)
                        url.openConnection();

        connection.setRequestMethod(
                "GET"
        );

        connection.setRequestProperty(
                "Authorization",
                "Bearer " + sessionToken
        );

        connection.setConnectTimeout(
                10000
        );

        connection.setReadTimeout(
                15000
        );

        int code =
                connection.getResponseCode();

        BufferedReader reader =
                new BufferedReader(
                        new InputStreamReader(
                                code >= 400
                                        ? connection.getErrorStream()
                                        : connection.getInputStream()
                        )
                );

        StringBuilder result =
                new StringBuilder();

        String line;

        while (
                (line = reader.readLine()) != null
        ) {
            result.append(line);
        }

        reader.close();

        connection.disconnect();

        if (code < 200 || code >= 300) {

            throw new Exception(
                    "HTTP " +
                    code +
                    "\n" +
                    result
            );
        }

        return new JSONObject(
                result.toString()
        );
    }

    /*
     * ==========================================
     * HTTP POST AUTHENTIFIÉ
     * ==========================================
     */

    private JSONObject postAuthenticated(
            String urlString,
            JSONObject data
    ) throws Exception {

        return postInternal(
                urlString,
                data,
                true
        );
    }

    /*
     * ==========================================
     * HTTP POST SANS AUTH
     * ==========================================
     */

    private JSONObject postWithoutAuth(
            String urlString,
            JSONObject data
    ) throws Exception {

        return postInternal(
                urlString,
                data,
                false
        );
    }

    /*
     * ==========================================
     * POST INTERNE
     * ==========================================
     */

    private JSONObject postInternal(
            String urlString,
            JSONObject data,
            boolean authenticated
    ) throws Exception {

        URL url =
                new URL(urlString);

                new URL(urlString);

        HttpURLConnection connection =
                (HttpURLConnection)
                        url.openConnection();

        connection.setRequestMethod(
                "POST"
        );

        connection.setRequestProperty(
                "Content-Type",
                "application/json"
        );

        if (authenticated) {

            connection.setRequestProperty(
                    "Authorization",
                    "Bearer " + sessionToken
            );
        }

        connection.setDoOutput(true);

        connection.setConnectTimeout(
                10000
        );

        connection.setReadTimeout(
                15000
        );

        byte[] body =
                data.toString()
                        .getBytes("UTF-8");

        OutputStream output =
                connection.getOutputStream();

        output.write(body);
        output.flush();
        output.close();

        int code =
                connection.getResponseCode();

        BufferedReader reader =
                new BufferedReader(
                        new InputStreamReader(
                                code >= 400
                                        ? connection.getErrorStream()
                                        : connection.getInputStream()
                        )
                );

        StringBuilder result =
                new StringBuilder();

        String line;

        while (
                (line = reader.readLine()) != null
        ) {
            result.append(line);
        }

        reader.close();
        connection.disconnect();

        if (code < 200 || code >= 300) {

            throw new Exception(
                    "HTTP " +
                    code +
                    "\n" +
                    result
            );
        }

        return new JSONObject(
                result.toString()
        );
    }

    private boolean isUnauthorized(
            Exception e
    ) {

        String message =
                e.getMessage();

        return message != null &&
                message.contains(
                        "HTTP 401"
                );
    }
