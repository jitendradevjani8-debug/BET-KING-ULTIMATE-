    /*
     * ==========================================
     * AUTO AUTHENTICATION
     * ==========================================
     */

    private void autoAuthenticate() {

        statusText.setText(
                "🔐 Authentification automatique..."
        );

        new Thread(() -> {

            try {

                JSONObject response =
                        postWithoutAuth(
                                API_BASE +
                                "/auth/auto-owner",
                                new JSONObject()
                        );

                boolean ok =
                        response.optBoolean(
                                "ok",
                                false
                        );

                if (!ok) {
                    throw new Exception(
                            "Auto-auth refusée."
                    );
                }

                JSONObject session =
                        response.getJSONObject(
                                "session"
                        );

                sessionToken =
                        session.getString(
                                "token"
                        );

                JSONObject user =
                        response.getJSONObject(
                                "user"
                        );

                String username =
                        user.optString(
                                "username",
                                "owner"
                        );

                String role =
                        user.optString(
                                "role",
                                "OWNER"
                        );

                handler.post(() -> {

                    statusText.setText(
                            "🟢 CONNECTÉ — " +
                            username +
                            " (" +
                            role +
                            ")"
                    );

                    loadDashboard();
                });

            } catch (Exception e) {

                handler.post(() -> {

                    sessionToken = null;

                    statusText.setText(
                            "🔴 AUTHENTIFICATION ÉCHOUÉE"
                    );

                    dashboardText.setText(
                            "Erreur : " +
                            e.getMessage()
                    );
                });
            }

        }).start();
    }

    /*
